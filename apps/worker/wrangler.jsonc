{
  "name": "cf-au-i01-p3-catalog-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "vars": {
    "JWT_EXPIRES_IN": "15m",
    "MAX_IMAGE_BYTES": "5242880",
    "COOKIE_SAME_SITE": "lax",
    "MEDIA_STRATEGY": "STATIC_ASSETS"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/public/*",
      "/auth/*",
      "/owner/*",
      "/admin/*",
      "/health",
      "/listings",
      "/listings/*/availability",
      "/listings/*/reconfirm",
      "/listings/*/images",
      "/listings/*/images/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-au-i01-p3-catalog-local",
      "database_id": "00000000-0000-0000-0000-000000000030",
      "migrations_dir": "migrations"
    }
  ]
}
