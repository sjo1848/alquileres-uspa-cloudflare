{
  "name": "cf-au-i01-p2-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "local:up": "wrangler d1 migrations apply DB --local && wrangler d1 execute DB --local --file tests/seed.sql && wrangler dev --local",
    "seed:catalog": "wrangler d1 migrations apply DB --local && wrangler d1 execute DB --local --file tests/seed-catalog.sql",
    "test": "node tests/retry-idempotency.mjs && node tests/http.mjs",
    "test:retry": "node tests/retry-idempotency.mjs",
    "test:catalog": "vitest run --config vitest.config.ts tests/public-listings.test.ts",
    "typecheck": "tsc --noEmit",
    "test:media": "vitest run --config vitest.config.ts tests/media-blob-spike.test.ts tests/owner-d1-blob-media.test.ts",
    "test:owner": "vitest run --config vitest.config.ts tests/owner-lifecycle.test.ts",
    "test:preview-auth": "vitest run --config vitest.config.ts tests/preview-auth.test.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "hono": "4.13.13",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@cloudflare/workers-types": "5.20261012.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "workerd@1.20261006.1": true
  }
}
